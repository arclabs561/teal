+    #[tokio::test]
+    #[ignore = "requires DATABASE_URL pointing at a migrated Postgres database"]
+    async fn keeps_distinct_recordings_across_play_collections() -> anyhow::Result<()> {
+        let pool = test_pool().await?;
+        let ingestor = PlayIngestor::new(pool.clone());
+        let alpha_mbid = Uuid::new_v4();
+        let stable_mbid = Uuid::new_v4();
+        let mut counts = Vec::new();
+
+        for alpha_first in [true, false] {
+            let tag = Uuid::new_v4().simple().to_string();
+            let did = format!("did:web:cadet-replay-{tag}.example");
+            let event =
+                |collection: &str, rkey: &str, artist: &str, mbid: Uuid, time: &str| Event {
+                    did: did.clone(),
+                    time_us: Some(1),
+                    kind: Kind::Commit,
+                    commit: Some(Commit {
+                        rev: "test-rev".to_owned(),
+                        operation: Operation::Create,
+                        collection: collection.to_owned(),
+                        rkey: rkey.to_owned(),
+                        record: Some(json!({
+                            "$type": collection,
+                            "trackName": "Intro",
+                            "recordingMbId": format!("mbid:{mbid}"),
+                            "artists": [{ "artistName": artist }],
+                            "playedTime": time
+                        })),
+                        cid: Some(format!("bafy-{rkey}")),
+                    }),
+                    identity: None,
+                };
+            let alpha = event(
+                ALPHA_FEED_PLAY,
+                "intro-alpha",
+                "Cadet Test Artist A",
+                alpha_mbid,
+                "2026-01-12T22:24:00Z",
+            );
+            let stable = event(
+                STABLE_FEED_PLAY,
+                "intro-stable",
+                "Cadet Test Artist B",
+                stable_mbid,
+                "2026-01-12T22:27:00Z",
+            );
+            let events = if alpha_first {
+                [alpha, stable]
+            } else {
+                [stable, alpha]
+            };
+            for event in events {
+                ingestor.ingest(event).await?;
+            }
+
+            let recordings = sqlx::query_scalar::<_, Option<Uuid>>(
+                "SELECT recording_mbid FROM plays WHERE did = $1 ORDER BY rkey",
+            )
+            .bind(&did)
+            .fetch_all(&pool)
+            .await?;
+            let order = if alpha_first {
+                "alpha-first"
+            } else {
+                "stable-first"
+            };
+            println!("{order} {did}: {recordings:?}");
+            counts.push(recordings);
+
+            let mut edit = event(
+                STABLE_FEED_PLAY,
+                "intro-stable",
+                "Cadet Test Artist B",
+                stable_mbid,
+                "2026-01-12T22:27:00Z",
+            );
+            let commit = edit.commit.as_mut().expect("fixture has a commit");
+            commit.operation = Operation::Update;
+            commit.cid = Some("bafy-intro-stable-edit".to_owned());
+            commit.record.as_mut().expect("fixture has a record")["trackName"] =
+                json!("Intro (corrected)");
+            ingestor.ingest(edit).await?;
+
+            let edited = sqlx::query_scalar::<_, String>(
+                "SELECT track_name FROM plays WHERE did = $1 AND rkey = 'intro-stable'",
+            )
+            .bind(&did)
+            .fetch_one(&pool)
+            .await?;
+            assert_eq!(edited, "Intro (corrected)");
+
+            for (rkey, collection) in [
+                ("intro-alpha", ALPHA_FEED_PLAY),
+                ("intro-stable", STABLE_FEED_PLAY),
+            ] {
+                let uri = format!("at://{did}/{STABLE_FEED_PLAY}/{rkey}");
+                ingestor.remove_play(&uri, collection).await?;
+            }
+        }
+        let expected = vec![Some(alpha_mbid), Some(stable_mbid)];
+        assert_eq!(counts, vec![expected.clone(), expected]);
+        Ok(())
+    }
+
